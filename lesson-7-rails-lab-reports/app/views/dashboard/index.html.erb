<div class="w-full flex flex-col gap-4">
  <div class="surface-overlay rounded-lg border px-4 py-2">
    <h1 class="text-xl sm:text-2xl font-semibold">Dashboard</h1>
  </div>

  <div class="surface-overlay rounded-lg overflow-hidden border">
    <% menu_items.each do |item| %>
      <div class="not-last:border-b hover:bg-gray-50 transition duration-200 hover:text-blue-700">
        <%= link_to item[:url], class: 'flex items-center px-4 py-4 gap-3' do %>
          <i class="<%= item[:icon] %>"></i>
          <div>
            <h2><%= item[:name] %></h2>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
