<% content_for :title, @lab_report.title %>
<% content_for :previous_title, "Lab Reports" %>
<% content_for :previous_url, lab_reports_path %>

<div class="p-4 max-w-lg">
  <div class="flex gap-1 mb-2">
    <%= link_to edit_lab_report_path(@lab_report), class: "bg-blue-500 hover:bg-blue-600 transition rounded px-2 py-1 text-white" do %>
      <i class="fa-solid fa-pencil"></i>
    <% end %>
    <%= button_to lab_report_path(@lab_report), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete the lab report?" } }, class: "bg-red-600 hover:bg-red-500 cursor-pointer px-2 rounded py-1 text-white" do %>
      <i class="fa-solid fa-trash"></i>
    <% end %>
  </div>

  <p class="mb-2">
    <span class="font-semibold">Grade:</span>
    <% if @lab_report.grade %>
      <span class="font-bold <%= grade_color_classes(@lab_report.grade) %>"><%= @lab_report.grade %></span>
    <% else %>
      –
    <% end %>

  </p>

  <p class="mb-2">
    <span class="font-semibold">User:</span>
    <% if @lab_report.user %>
      <%= link_to user_path(@lab_report.user), class: "hover:text-blue-500 transition" do %>
        <%= @lab_report.user.full_name %>
      <% end %>
    <% else %>
      –
    <% end %>
  </p>

  <p class="font-semibold">Description:</p>
  <p><%= @lab_report.description %></p>
</div>
