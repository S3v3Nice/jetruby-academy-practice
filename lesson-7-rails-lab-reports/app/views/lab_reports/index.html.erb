<% content_for :title, "Lab Reports" %>
<% content_for :previous_title, "Dashboard" %>
<% content_for :previous_url, root_path %>

<div class="p-4">
  <%= link_to new_lab_report_path, class: "bg-blue-500 hover:bg-blue-600 transition rounded px-2 py-1 text-white" do %>
    <i class="fa-solid fa-plus"></i>
  <% end %>

  <div class="mt-3 flex flex-col gap-2">
    <% @lab_reports.each do |lab_report| %>
      <%= render "card", lab_report: lab_report %>
    <% end %>
  </div>
</div>
