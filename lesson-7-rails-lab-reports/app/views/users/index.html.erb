<div class="w-full flex flex-col gap-4">
  <div class="surface-overlay rounded-lg border flex items-center">
    <%= link_to root_path do %>
      <i class="fa-solid fa-arrow-left p-4"></i>
    <% end %>
    <div class="flex flex-col py-2">
      <%= link_to root_path do %>
        <p class="text-xs opacity-70">Dashboard</p>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-semibold">Users</h1>
    </div>
  </div>

  <div class="surface-overlay rounded-lg overflow-hidden border p-4">
    <%= link_to new_user_path, class: "bg-blue-500 hover:bg-blue-600 transition rounded px-2 py-1 text-white" do %>
      <i class="fa-solid fa-plus"></i>
    <% end %>

    <div class="overflow-x-auto mt-3 rounded-lg  border border-gray-30">
      <table class="min-w-full border-separate border-spacing-0 rounded-lg">
        <thead>
        <tr class="bg-gray-200 text-left rounded-t-lg">
          <th class="p-3">Name</th>
          <th class="p-3">Email</th>
          <th class="p-3">Lab Reports</th>
          <th class="p-3">Actions</th>
        </tr>
        </thead>

        <tbody>
        <% @users.each do |user| %>
          <tr class="even:bg-gray-100 last:rounded-b-lg">
            <td class="p-3 whitespace-nowrap"><%= user.first_name %> <%= user.last_name %></td>
            <td class="p-3 whitespace-nowrap"><%= user.email %></td>
            <td class="p-3 whitespace-nowrap"><%= user.lab_reports.count %></td>
            <td class="p-3">
              <div class="flex items-center gap-3">
                <%= link_to edit_user_path(user), class: "text-gray-500 hover:text-blue-700" do %>
                  <i class="fa-solid fa-pencil"></i>
                <% end %>
                <%= button_to user_path(user), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete the user?" } }, class: "text-red-600 hover:text-red-400 cursor-pointer" do %>
                  <i class="fa-solid fa-trash"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>
