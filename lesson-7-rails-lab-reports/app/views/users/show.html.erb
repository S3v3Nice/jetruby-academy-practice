<% content_for :title, @user.full_name %>
<% content_for :previous_title, "Users" %>
<% content_for :previous_url, users_path %>

<div class="p-4 flex flex-col gap-2 max-w-lg">
  <div class="flex gap-1 mb-2">
    <%= link_to edit_user_path(@user), class: "bg-blue-500 hover:bg-blue-600 transition rounded px-2 py-1 text-white" do %>
      <i class="fa-solid fa-pencil"></i>
    <% end %>
    <%= button_to user_path(@user), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete the user?" } }, class: "bg-red-600 hover:bg-red-500 cursor-pointer px-2 rounded py-1 text-white" do %>
      <i class="fa-solid fa-trash"></i>
    <% end %>
  </div>

  <div>
    <span class="font-bold">First name: </span>
    <span><%= @user.first_name %></span>
  </div>

  <div>
    <span class="font-bold">Last name: </span>
    <span><%= @user.last_name %></span>
  </div>

  <div>
    <span class="font-bold">Email: </span>
    <span><%= @user.email %></span>
  </div>
</div>
