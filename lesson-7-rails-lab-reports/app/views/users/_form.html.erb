<%= form_with model: user, class: "max-w-lg mx-auto" do |form| %>
  <div class="flex flex-col gap-4">

    <!-- First name -->
    <div>
      <%= form.label :first_name %>
      <%= form.text_field :first_name, class: "w-full mt-1 px-4 py-2 border rounded focus:ring focus:ring-blue-300 outline-none" %>
      <% user.errors.full_messages_for(:first_name).each do |error| %>
        <div class="text-red-600 text-sm mt-1"><%= error %></div>
      <% end %>
    </div>

    <!-- Last name -->
    <div>
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: "w-full mt-1 px-4 py-2 border rounded focus:ring focus:ring-blue-300 outline-none" %>
      <% user.errors.full_messages_for(:last_name).each do |error| %>
        <div class="text-red-600 text-sm mt-1"><%= error %></div>
      <% end %>
    </div>

    <!-- Email -->
    <div>
      <%= form.label :email %>
      <%= form.text_field :email, class: "w-full mt-1 px-4 py-2 border rounded focus:ring focus:ring-blue-300 outline-none" %>
      <% user.errors.full_messages_for(:email).each do |error| %>
        <div class="text-red-600 text-sm mt-1"><%= error %></div>
      <% end %>
    </div>

    <!-- Submit -->
    <div>
      <%= form.submit class: "w-full text-white py-2 px-4 rounded cursor-pointer bg-blue-500 hover:bg-blue-600 transition duration-200" %>
    </div>
  </div>
<% end %>
