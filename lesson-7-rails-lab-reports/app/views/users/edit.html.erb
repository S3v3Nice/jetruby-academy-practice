<div class="w-full flex flex-col gap-4">
  <div class="surface-overlay rounded-lg border flex items-center">
    <%= link_to users_path do %>
      <i class="fa-solid fa-arrow-left p-4"></i>
    <% end %>
    <div class="flex flex-col py-2">
      <%= link_to users_path do %>
        <p class="text-xs opacity-70">Users</p>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-semibold">Edit User</h1>
    </div>
  </div>

  <div class="surface-overlay rounded-lg overflow-hidden border p-4">
    <%= render "form", user: @user %>
  </div>
</div>
